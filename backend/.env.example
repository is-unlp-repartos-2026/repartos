# Copiar este archivo como .env y ajustar los valores. El .env NO se sube al repo.

# --- Base de datos (la usan docker compose y la app) ---
POSTGRES_USER=siger
POSTGRES_PASSWORD=siger
POSTGRES_DB=siger
# Puerto de tu máquina donde queda la base. Si el 5432 está ocupado, usá otro (ej: 5433)
# y cambiá también el número en DATABASE_URL.
POSTGRES_PORT=5432

# Dirección completa de la base que usa la app:
# postgresql+psycopg://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://siger:siger@localhost:5432/siger

# --- Seguridad ---
# Clave para firmar los tokens de login. Generá una propia con:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-generada
